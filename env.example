# Copy this to .env.local and fill in your keys
# Pick ONE provider and fill in that key (or add multiple for fallback)

# Option A: OpenRouter (recommended — access to many models)
OPENROUTER_API_KEY=your_openrouter_key_here

# Option B: Google Gemini
GEMINI_API_KEY=your_gemini_key_here

# Option C: Groq (fastest, good for chat)
GROQ_API_KEY=your_groq_key_here

# Which provider to use: "openrouter" | "gemini" | "groq"
AI_PROVIDER=openrouter

# Optional: model override (defaults are set per provider)
# AI_MODEL=meta-llama/llama-3.3-70b-instruct
